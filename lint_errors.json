tton px-6 py-2 bg-[#111] text-white rounded-full font-mono text-xs uppercase tracking-widest hover:bg-[#5A4A32] transition-colors border border-transparent hover:border-[#5A4A32]/20 shadow-lg shadow-black/5\"\r\n                    >\r\n                        Get App\r\n                    </button>\r\n                </nav>\r\n\r\n\r\n                <div className=\"flex items-center gap-4 md:hidden\">\r\n                    {/* Mobile Get App Button (Visible on Navbar) */}\r\n                    <button\r\n                        onClick={handleInstallClick}\r\n                        className=\"get-app-button px-4 py-2 bg-[#111] text-white rounded-full font-mono text-[10px] uppercase tracking-widest hover:bg-[#5A4A32] transition-colors border border-transparent shadow-md whitespace-nowrap\"\r\n                    >\r\n                        Get App\r\n                    </button>\r\n\r\n                    {/* Mobile Menu Toggle (CSS only) */}\r\n                    <button\r\n                        className=\"relative z-[200] w-10 h-10 flex flex-col justify-center items-center gap-[6px] group\"\r\n                        onClick={() => setIsMenuOpen(!isMenuOpen)}\r\n                        aria-label=\"Toggle Menu\"\r\n                    >\r\n                        <span\r\n                            className={cn(\r\n                                \"w-8 h-[2px] bg-[#111] block rounded-full transition-transform duration-300\",\r\n                                isMenuOpen && \"rotate-45 translate-y-2\"\r\n                            )}\r\n                        />\r\n                        <span\r\n                            className={cn(\r\n                                \"w-8 h-[2px] bg-[#111] block rounded-full transition-opacity duration-300\",\r\n                                isMenuOpen && \"opacity-0\"\r\n                            )}\r\n                        />\r\n                        <span\r\n                            className=